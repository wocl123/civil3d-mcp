{
  "name": "my-civil3d-mcp-server",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "smoke:service": "npm run build && node scripts/service-smoke.mjs && node scripts/service-lifetime.mjs",
    "smoke:usage": "npm run build && node scripts/usage-smoke.mjs",
    "smoke:memory": "npm run build && node scripts/memory-smoke.mjs",
    "smoke:knowledge": "npm run build && node scripts/knowledge-smoke.mjs",
    "service": "node build/localService.js",
    "law:fetch": "npm run build && node scripts/law-fetch.mjs",
    "test:design": "npm run build && node scripts/design-regression.mjs",
    "test:tools": "npm run build && node scripts/tool-contract.mjs",
    "test:central": "npm run build && npm --prefix ../central run build && node scripts/central-e2e.mjs",
    "smoke:cli": "npm run build && node scripts/cli-smoke.mjs && node scripts/cli-missing-scenario.mjs",
    "test:safety": "npm run build && node scripts/safety-regression.mjs",
    "test:delete": "npm run build && node scripts/delete-scenario.mjs",
    "test:edit": "npm run build && node scripts/edit-scenario.mjs",
    "test:reconnect": "npm run build && node scripts/reconnect-scenario.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "typescript": "5.8.2"
  }
}
