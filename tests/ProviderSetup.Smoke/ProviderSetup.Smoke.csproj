<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../plugin/UI/*.cs" Exclude="../../plugin/UI/ChatPalette.cs;../../plugin/UI/PaletteApiClient.cs" Link="UI/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../plugin/UI/Assets/*.svg" LogicalName="ProviderIcons.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
